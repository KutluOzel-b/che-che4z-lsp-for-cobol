{
  "type": "array",
  "description": "List of folders that contain copybooks.",
  "items": {
    "anyOf": [
      {
        "type": "string"
      },
      {
        "type": "object",
        "properties": {
          "dataset": {
            "type": "string",
            "description": "Name of a data set located on the mainframe."
          },
          "profile": {
            "type": "string",
            "description": "Profile name to be used by the Zowe Explorer extension"
          }
        },
        "required": ["dataset"]
      },
      {
        "type": "object",
        "properties": {
          "uss": {
            "type": "string",
            "description": "USS directory on the mainframe."
          },
          "profile": {
            "type": "string",
            "description": "Profile name to be used by the Zowe Explorer extension"
          }
        },
        "required": ["uss"]
      },
      {
        "type": "object",
        "properties": {
          "environment": {
            "type": "string",
            "description": "Endevor environment"
          },
          "stage": {
            "type": "string",
            "description": "Endevor stage"
          },
          "system": {
            "type": "string",
            "description": "Endevor system"
          },
          "subsystem": {
            "type": "string",
            "description": "Endevor subsystem"
          },
          "type": {
            "type": "string",
            "description": "Endevor type"
          },
          "use_map": {
            "type": "boolean",
            "description": "Build using map",
            "default": true
          },
          "profile": {
            "type": "string",
            "description": "Profile name to be used by the E4E extension"
          }
        },
        "required": ["environment", "stage", "system", "subsystem", "type"]
      },
      {
        "type": "object",
        "properties": {
          "locationType": {
            "const": "local",
            "description": "TAR file is located locally"
          },
          "tarFileLocation": {
            "type": "string",
            "description": "Path of the TAR file located locally on the current machine"
          },
          "folderPattern": {
            "type": "string",
            "description": "Path or wildcard pattern of folders within the TAR file to search for copybooks",
            "default": "**"
          }
        },
        "required": ["locationType", "tarFileLocation"]
      },
      {
        "type": "object",
        "properties": {
          "locationType": {
            "type": "string",
            "enum": ["DSN", "USS"],
            "description": "Type of the remote location where the TAR file is stored (DSN or USS)"
          },
          "tarFileLocation": {
            "type": "string",
            "description": "Data set name or USS directory path of the TAR file"
          },
          "folderPattern": {
            "type": "string",
            "description": "Path or wildcard pattern of folders within the TAR file to search for copybooks",
            "default": "**"
          },
          "profile": {
            "type": "string",
            "description": "Zowe Explorer profile name"
          }
        },
        "required": ["locationType", "tarFileLocation"]
      }
    ]
  }
}
