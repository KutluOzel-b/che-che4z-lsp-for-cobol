{
  "type": "array",
  "description": "List of folders that contain copybooks.",
  "items": {
    "anyOf": [
      {
        "type": "string"
      },
      {
        "type": "object",
        "properties": {
          "dataset": {
            "type": "string",
            "description": "Name of a data set located on the mainframe."
          },
          "profile": {
            "type": "string",
            "description": "Profile name to be used by the Zowe Explorer extension"
          }
        },
        "required": ["dataset"]
      },
      {
        "type": "object",
        "properties": {
          "uss": {
            "type": "string",
            "description": "USS directory on the mainframe."
          },
          "profile": {
            "type": "string",
            "description": "Profile name to be used by the Zowe Explorer extension"
          }
        },
        "required": ["uss"]
      },
      {
        "type": "object",
        "properties": {
          "environment": {
            "type": "string",
            "description": "Endevor environment"
          },
          "stage": {
            "type": "string",
            "description": "Endevor stage"
          },
          "system": {
            "type": "string",
            "description": "Endevor system"
          },
          "subsystem": {
            "type": "string",
            "description": "Endevor subsystem"
          },
          "type": {
            "type": "string",
            "description": "Endevor type"
          },
          "use_map": {
            "type": "boolean",
            "description": "Build using map",
            "default": true
          },
          "profile": {
            "type": "string",
            "description": "Profile name to be used by the E4E extension"
          }
        },
        "required": ["environment", "stage", "system", "subsystem", "type"]
      },
      {
        "type": "object",
        "properties": {
          "locationType": {
            "const": "local",
            "description": "TAR file is located locally"
          },
          "tarFileLocation": {
            "type": "string",
            "description": "path of the tar file located locally on the current machine"
          },
          "searchPattern": {
            "type": "string",
            "description": "path/Wildcard pattern of folder structure within a tar file where copybooks needs to be searched",
            "default": "**"
          }
        },
        "required": ["locationType", "tarFileLocation", "searchPattern"]
      },
      {
        "type": "object",
        "properties": {
          "locationType": {
            "type": "string",
            "enum": ["DSN", "USS"],
            "description": "remote location type where TAR file is located. Can take either DSN or USS as value."
          },
          "tarFileLocation": {
            "type": "string",
            "description": "string representing the path of the tar file. This could be a dataset name if tar is located in DSN or a USS directory on the mainframe when tar is located in USS"
          },
          "searchPattern": {
            "type": "string",
            "description": "path/Wildcard pattern of folder structure within a tar file where copybooks needs to be searched",
            "default": "**"
          },
          "profile": {
            "type": "string",
            "description": "Profile name to be used by the ZE extension"
          }
        },
        "required": ["locationType", "tarFileLocation", "searchPattern"]
      }
    ]
  }
}
